{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@quiz-platform/shared$": "<rootDir>/../../../packages/shared/dist-cjs/index.js"
  },
  "setupFiles": [
    "<rootDir>/test-env.ts"
  ],
  "testTimeout": 30000
}
