# Sanitized template. Generate each key independently with: openssl rand -base64 32
# Blank required secrets deliberately prevent startup until configured.
NODE_ENV=development
AUTH_RELEASE_STAGE=local
WEB_ORIGIN=http://localhost:5173
PORT=3000
COOKIE_SECURE=false
TRUST_PROXY_HOPS=0
AUTH_OTP_MODE=off
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=10m
SESSION_IDLE_TTL_DAYS=7
SESSION_ABSOLUTE_TTL_DAYS=30
REFRESH_RACE_GRACE_SECONDS=10
OTP_PEPPER=
OTP_PEPPER_VERSION=1
AUTH_HASH_KEY=
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_15_MINUTES=3
OTP_MAX_SENDS_PER_IP_HOUR=10
TRUSTED_DEVICE_TTL_DAYS=30
TRUSTED_DEVICE_ABSOLUTE_MAX_DAYS=90
SECURITY_EVENT_RETENTION_DAYS=180
AUTH_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
# Build and runtime must agree; these two public values are safe in the SPA.
VITE_AUTH_GOOGLE_ENABLED=false
VITE_GOOGLE_CLIENT_ID=
MAIL_DRIVER=console
MAIL_FROM_EMAIL=operator@example.test
MAIL_FROM_NAME=Quiz Platform
MAIL_REPLY_TO=
MAIL_SENDER_AUTHENTICATED=false
AUTH_TEST_EMAIL_ALLOWLIST=
BREVO_API_KEY=
BREVO_WEBHOOK_SECRET=
# Optional during rotation only; an ISO timestamp no later than 24h after rotation.
BREVO_WEBHOOK_PREVIOUS_SECRET=
BREVO_WEBHOOK_PREVIOUS_UNTIL=
MAIL_PAYLOAD_KEY=
MAIL_PAYLOAD_KEY_VERSION=1
MAIL_DAILY_BUDGET=200
MAIL_NON_OTP_DAILY_LIMIT=50
MAIL_BUDGET_ALERT_PCT=80
MAIL_RATE_ALERT_COUNT=25
MAIL_RATE_ALERT_WINDOW_MINUTES=15
MAIL_RATE_ALERT_COOLDOWN_MINUTES=60
MAIL_REQUEST_TIMEOUT_MS=5000
MAIL_OUTBOX_RETRY_DELAYS=1m,5m,30m,2h,24h
DATABASE_URL=postgresql://postgres:local-only@localhost:5432/quiz_platform?connection_limit=20&pool_timeout=20
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=quiz-platform
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
