generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STUDENT
}

enum TenantRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum QuestionType {
  MCQ_SINGLE
  MCQ_MULTI
  TRUE_FALSE
  SHORT_TEXT
  NUMERIC
  ESSAY
  MATCHING
  FILL_BLANK
  FILE_UPLOAD
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

// Declared in play order — Postgres native enums sort by declaration
// ordinal, so `orderBy: [{ module: 'asc' }, { order: 'asc' }]` queries rely
// on this order to come back in actual SAT sequence.
enum QuizModule {
  RW_MODULE_1
  RW_MODULE_2
  MATH_MODULE_1
  MATH_MODULE_2
}

enum QuizStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

// FIXED: the admin authors an exact question set every student sees.
// BANK: the admin uploads a large tagged-difficulty pool and each attempt
// draws its own random SAT-sized subset (see PracticeAttemptQuestion).
enum PracticeQuizMode {
  FIXED
  BANK
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

model User {
  id                     String                 @id @default(cuid())
  email                  String
  emailNormalized        String                 @unique
  emailVerifiedAt        DateTime?              @db.Timestamptz(3)
  passwordHash           String?
  // Bumped whenever the password changes; embedded in every issued token and
  // checked on refresh — invalidates every other session's refresh token
  // (all other devices/tabs) the moment the password is changed, without a
  // token-revocation table. The session that made the change is re-issued
  // fresh tokens at the same call so only it survives.
  tokenVersion           Int                    @default(0)
  // Hashes of the last PASSWORD_HISTORY_LIMIT passwords (most recent first),
  // checked on change so a "new" password can't just be an old one again.
  previousPasswordHashes String[]               @default([])
  name                   String
  isSuperAdmin           Boolean                @default(false)
  isSuspended            Boolean                @default(false)
  suspendedAt            DateTime?
  lastLoginAt            DateTime?
  memberships            Membership[]
  workspaceJoinRequests  WorkspaceJoinRequest[]
  notifications          Notification[]
  identities             AuthIdentity[]
  sessions               Session[]
  trustedDevices         TrustedDevice[]
  challenges             AuthChallenge[]
  grants                 AuthGrant[]
  googleNonces           GoogleNonce[]
  pendingGoogleLinks     PendingGoogleLink[]
  pendingEmailChanges    PendingEmailChange[]
  loginRisk              AccountLoginRisk?
  securityEvents         SecurityEvent[]

  // Profile — most of these are only meaningful for STUDENT memberships
  // (gradeLevel, studentId, guardian*), but they live on User rather than a
  // role-scoped table since role is per-membership, not per-account.
  avatarUrl          String?
  firstName          String?
  lastName           String?
  dateOfBirth        DateTime? @db.Date
  bio                String?
  phone              String?
  location           String?
  timezone           String?
  locale             String?
  emailNotifications Boolean   @default(true)
  gradeLevel         String?
  studentId          String?
  guardianName       String?
  guardianContact    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tenant {
  id                    String                   @id @default(cuid())
  name                  String
  slug                  String                   @unique
  description           String?
  bannerImageUrl        String?
  joinCode              String?                  @unique
  status                TenantStatus             @default(ACTIVE)
  suspendedAt           DateTime?
  memberships           Membership[]
  groups                Group[]
  quizzes               Quiz[]
  assignments           QuizAssignment[]
  practiceQuizzes       PracticeQuiz[]
  practiceAssignments   PracticeQuizAssignment[]
  tenantRequests        TenantRequest[]
  workspaceJoinRequests WorkspaceJoinRequest[]
  memberInvitations     MemberInvitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A user can hold at most one membership per tenant (@@unique([userId,
// tenantId])), but may belong to multiple tenants at once — e.g. a student
// added by two different schools/workspaces.
model Membership {
  id       String @id @default(cuid())
  userId   String
  tenantId String
  role     Role

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdQuizzes      Quiz[]             @relation("QuizCreatedBy")
  groupMemberships    GroupMember[]
  assignmentsCreated  QuizAssignment[]   @relation("AssignmentCreatedBy")
  assignmentsReceived QuizAssignment[]   @relation("AssignmentStudent")
  attempts            Attempt[]
  gradedResponses     Response[]         @relation("ResponseGradedBy")
  auditLogs           AuditLog[]
  sentInvitations     MemberInvitation[]
  sessions            Session[]
  notifications       Notification[]

  createdPracticeQuizzes      PracticeQuiz[]           @relation("PracticeQuizCreatedBy")
  practiceAssignmentsCreated  PracticeQuizAssignment[] @relation("PracticeAssignmentCreatedBy")
  practiceAssignmentsReceived PracticeQuizAssignment[] @relation("PracticeAssignmentStudent")
  practiceAttempts            PracticeAttempt[]
  gradedPracticeResponses     PracticeResponse[]       @relation("PracticeResponseGradedBy")
  practiceAuditLogs           PracticeAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tenantId])
  @@index([tenantId])
}

// A public request for a new workspace, reviewed by a platform super admin
// (User.isSuperAdmin). Approval creates the Tenant + User + Membership.
model TenantRequest {
  id              String              @id @default(cuid())
  workspaceName   String
  slug            String
  description     String?
  requesterName   String
  requesterEmail  String
  emailNormalized String
  emailVerifiedAt DateTime?           @db.Timestamptz(3)
  contextHash     String
  expiresAt       DateTime            @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)
  challenges      AuthChallenge[]
  passwordHash    String?
  status          TenantRequestStatus @default(PENDING)
  tenantId        String?
  tenant          Tenant?             @relation(fields: [tenantId], references: [id])

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
}

// A registered user asking to join an existing tenant as a STUDENT,
// reviewed by that tenant's own ADMIN(s). Distinct from TenantRequest,
// which is a request to create a brand-new tenant, reviewed by the
// platform super admin.
model WorkspaceJoinRequest {
  id       String              @id @default(cuid())
  userId   String
  tenantId String
  status   TenantRequestStatus @default(PENDING)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  @@index([tenantId])
  @@index([userId])
}

enum MemberInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

// An admin-initiated invite for an email with no existing account yet.
// Distinct from WorkspaceJoinRequest, which is student-initiated — an
// invitation is created by the tenant's own admin and pre-assigns a role;
// the invitee accepts it by setting a password at /accept-invite/:token.
// A single-use, expiring token for the "forgot password" flow. The token
// itself is only ever emailed to the user — tokenHash (sha256) is what's
// stored, so a DB leak alone can't be used to take over accounts.
model MemberInvitation {
  id                    String                 @id @default(cuid())
  tenantId              String
  email                 String
  role                  Role
  tokenHash             String                 @unique
  emailNormalized       String
  expiresAt             DateTime               @db.Timestamptz(3)
  lastSentAt            DateTime?              @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(3)
  challenges            AuthChallenge[]
  pendingRegistrations  PendingRegistration[]
  status                MemberInvitationStatus @default(PENDING)
  invitedByMembershipId String?

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy Membership? @relation(fields: [invitedByMembershipId], references: [id])

  createdAt  DateTime  @default(now())
  acceptedAt DateTime?

  @@index([tenantId])
}

model Group {
  id       String @id @default(cuid())
  tenantId String
  name     String

  tenant              Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members             GroupMember[]
  assignments         QuizAssignment[]
  practiceAssignments PracticeQuizAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model GroupMember {
  id           String @id @default(cuid())
  groupId      String
  membershipId String

  group      Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([groupId, membershipId])
}

model Quiz {
  id                       String     @id @default(cuid())
  tenantId                 String
  createdByMembershipId    String
  title                    String
  description              String?
  maxAttempts              Int?
  shuffleQuestions         Boolean    @default(false)
  shuffleOptions           Boolean    @default(false)
  showDifficultyToStudents Boolean    @default(false)
  availableFrom            DateTime?
  availableUntil           DateTime?
  passMarkPercent          Decimal?   @db.Decimal(5, 2)
  status                   QuizStatus @default(DRAFT)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy   Membership       @relation("QuizCreatedBy", fields: [createdByMembershipId], references: [id])
  questions   Question[]
  assignments QuizAssignment[]
  attempts    Attempt[]
  auditLogs   AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// `config` holds type-specific settings (numeric tolerance, matching
// pairs, blank definitions...) per packages/shared question-config schemas.
// MCQ_SINGLE / MCQ_MULTI / TRUE_FALSE use QuestionOption instead.
model Question {
  id         String              @id @default(cuid())
  quizId     String
  module     QuizModule
  type       QuestionType
  prompt     String
  points     Decimal             @db.Decimal(6, 2)
  // Position within this question's module, not the whole quiz — order is
  // scoped to (quizId, module) by the create/reorder/duplicate logic.
  order      Int
  config     Json                @default("{}")
  difficulty QuestionDifficulty?

  // Optional reference document (PDF/DOCX) a teacher attaches for students
  // to view alongside the question — separate from `config` so it survives
  // the per-type answer-key stripping in question-sanitizer.ts untouched.
  attachmentKey      String?
  attachmentFilename String?
  attachmentMimeType String?

  // Optional image shown inline with the question prompt — distinct from the
  // reference-document attachment above.
  imageKey      String?
  imageFilename String?
  imageMimeType String?

  quiz      Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options   QuestionOption[]
  responses Response[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quizId])
}

model QuestionOption {
  id         String  @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean @default(false)
  order      Int

  // Optional image shown inline with this answer option.
  imageKey      String?
  imageFilename String?
  imageMimeType String?

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

// Exactly one of studentMembershipId / groupId is set.
model QuizAssignment {
  id                     String    @id @default(cuid())
  tenantId               String
  quizId                 String
  studentMembershipId    String?
  groupId                String?
  assignedByMembershipId String
  dueAt                  DateTime?

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quiz       Quiz        @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student    Membership? @relation("AssignmentStudent", fields: [studentMembershipId], references: [id], onDelete: Cascade)
  group      Group?      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  assignedBy Membership  @relation("AssignmentCreatedBy", fields: [assignedByMembershipId], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([quizId])
}

model Attempt {
  id                  String        @id @default(cuid())
  quizId              String
  studentMembershipId String
  attemptNumber       Int
  status              AttemptStatus @default(IN_PROGRESS)
  startedAt           DateTime      @default(now())
  submittedAt         DateTime?
  score               Decimal?      @db.Decimal(7, 2)
  maxScore            Decimal?      @db.Decimal(7, 2)

  // Single-active-session lock, held by whichever login session is currently
  // taking this attempt. `lockSessionId` matches the `sessionId` claim on
  // that session's JWTs; a new login for this attempt's student is refused
  // (see AuthService.issueTokensForMembership) while lastHeartbeatAt is
  // still within the liveness window, so at most one device can act on an
  // in-progress attempt at a time. Cleared on submit, and force-clearable by
  // a teacher if a device goes stale without a clean handoff.
  lockSessionId   String?
  lockedAt        DateTime?
  lastHeartbeatAt DateTime?

  quiz      Quiz                    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student   Membership              @relation(fields: [studentMembershipId], references: [id], onDelete: Cascade)
  responses Response[]
  modules   AttemptModuleProgress[]

  @@unique([quizId, studentMembershipId, attemptNumber])
  @@index([quizId])
  @@index([studentMembershipId])
}

// Tracks per-module timing/completion within one Attempt. A row's absence
// of `submittedAt` marks it the currently-active module; the next module's
// row is only created once the previous one is explicitly completed (see
// AttemptsService.completeCurrentModule/beginNextModule), so there is at
// most one "open" row per attempt at a time. This is what makes the fixed
// 32/32/35/35-minute module timers server-enforced rather than merely
// displayed to the client.
model AttemptModuleProgress {
  id            String     @id @default(cuid())
  attemptId     String
  module        QuizModule
  startedAt     DateTime   @default(now())
  submittedAt   DateTime?
  autoSubmitted Boolean    @default(false)

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, module])
  @@index([attemptId])
}

model Response {
  id                   String   @id @default(cuid())
  attemptId            String
  questionId           String
  answer               Json?
  fileKey              String?
  awardedPoints        Decimal? @db.Decimal(6, 2)
  autoGraded           Boolean  @default(false)
  gradedByMembershipId String?
  feedback             String?

  attempt  Attempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  gradedBy Membership? @relation("ResponseGradedBy", fields: [gradedByMembershipId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

// A persisted, human-readable history of actions taken on a quiz — powers
// the quiz detail page's "Activity log". `action` is a small closed set of
// string tags ('QUIZ_CREATED' | 'STATUS_CHANGED' | 'SETTINGS_UPDATED' |
// 'QUESTIONS_UPDATED' | 'ASSIGNMENT_CREATED' | 'ASSIGNMENT_REMOVED'); kept
// as a plain string rather than an enum since new action types are cheap to
// add and don't need a migration. `detail` carries the one piece of
// context each message needs (new status, or an assignment target name).
model AuditLog {
  id                String  @id @default(cuid())
  tenantId          String
  quizId            String?
  actorMembershipId String?
  action            String
  detail            String?

  quiz  Quiz?       @relation(fields: [quizId], references: [id], onDelete: Cascade)
  actor Membership? @relation(fields: [actorMembershipId], references: [id])

  createdAt DateTime @default(now())

  @@index([quizId])
  @@index([tenantId])
}

// Practice Quiz is a fully independent copy of the Quiz feature (own tables,
// own services/controllers) so bug fixes or behavior changes on one never
// affect the other. Field-for-field mirror of Quiz/Question/QuestionOption/
// QuizAssignment/Attempt/AttemptModuleProgress/Response/AuditLog above.

model PracticeQuiz {
  id                       String     @id @default(cuid())
  tenantId                 String
  createdByMembershipId    String
  title                    String
  description              String?
  maxAttempts              Int?
  shuffleQuestions         Boolean    @default(false)
  shuffleOptions           Boolean    @default(false)
  showDifficultyToStudents Boolean    @default(false)
  availableFrom            DateTime?
  availableUntil           DateTime?
  passMarkPercent          Decimal?   @db.Decimal(5, 2)
  status                   QuizStatus @default(DRAFT)

  // Set at creation, immutable after — see PracticeQuizMode. bankModuleTargets
  // is Record<QuizModule, number>; bankDifficultyRatio is
  // {EASY,MEDIUM,HARD} percentages summing to 100. Both null for FIXED mode.
  mode                PracticeQuizMode @default(FIXED)
  bankModuleTargets   Json?
  bankDifficultyRatio Json?

  tenant      Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy   Membership               @relation("PracticeQuizCreatedBy", fields: [createdByMembershipId], references: [id])
  questions   PracticeQuestion[]
  assignments PracticeQuizAssignment[]
  attempts    PracticeAttempt[]
  auditLogs   PracticeAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model PracticeQuestion {
  id         String              @id @default(cuid())
  quizId     String
  module     QuizModule
  type       QuestionType
  prompt     String
  points     Decimal             @db.Decimal(6, 2)
  order      Int
  config     Json                @default("{}")
  difficulty QuestionDifficulty?

  attachmentKey      String?
  attachmentFilename String?
  attachmentMimeType String?

  imageKey      String?
  imageFilename String?
  imageMimeType String?

  quiz      PracticeQuiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options   PracticeQuestionOption[]
  responses PracticeResponse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quizId])
}

model PracticeQuestionOption {
  id         String  @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean @default(false)
  order      Int

  imageKey      String?
  imageFilename String?
  imageMimeType String?

  question PracticeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

// Exactly one of studentMembershipId / groupId is set.
model PracticeQuizAssignment {
  id                     String    @id @default(cuid())
  tenantId               String
  quizId                 String
  studentMembershipId    String?
  groupId                String?
  assignedByMembershipId String
  dueAt                  DateTime?

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quiz       PracticeQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student    Membership?  @relation("PracticeAssignmentStudent", fields: [studentMembershipId], references: [id], onDelete: Cascade)
  group      Group?       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  assignedBy Membership   @relation("PracticeAssignmentCreatedBy", fields: [assignedByMembershipId], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([quizId])
}

model PracticeAttempt {
  id                  String        @id @default(cuid())
  quizId              String
  studentMembershipId String
  attemptNumber       Int
  status              AttemptStatus @default(IN_PROGRESS)
  startedAt           DateTime      @default(now())
  submittedAt         DateTime?
  score               Decimal?      @db.Decimal(7, 2)
  maxScore            Decimal?      @db.Decimal(7, 2)

  // Single-active-session lock — see Attempt.lockSessionId above for the
  // full mechanics; identical here.
  lockSessionId   String?
  lockedAt        DateTime?
  lastHeartbeatAt DateTime?

  quiz      PracticeQuiz                    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student   Membership                      @relation(fields: [studentMembershipId], references: [id], onDelete: Cascade)
  responses PracticeResponse[]
  modules   PracticeAttemptModuleProgress[]

  // BANK-mode only — see PracticeAttemptQuestion.
  attemptQuestions PracticeAttemptQuestion[]
  attemptResponses PracticeAttemptResponse[]

  @@unique([quizId, studentMembershipId, attemptNumber])
  @@index([quizId])
  @@index([studentMembershipId])
}

// See AttemptModuleProgress above — identical per-module timing/completion
// tracking, mirrored for PracticeAttempt.
model PracticeAttemptModuleProgress {
  id            String     @id @default(cuid())
  attemptId     String
  module        QuizModule
  startedAt     DateTime   @default(now())
  submittedAt   DateTime?
  autoSubmitted Boolean    @default(false)

  attempt PracticeAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, module])
  @@index([attemptId])
}

// One row per question actually drawn into a BANK-mode attempt — a frozen
// content copy, field-for-field mirroring PracticeQuestion, so review stays
// correct forever even after the admin edits or deletes the source bank
// question. `sourceQuestionId` is provenance only (no FK, no cascade) —
// deleting the live bank question must never touch an attempt's snapshot.
model PracticeAttemptQuestion {
  id         String              @id @default(cuid())
  attemptId  String
  module     QuizModule
  type       QuestionType
  prompt     String
  points     Decimal             @db.Decimal(6, 2)
  order      Int
  config     Json                @default("{}")
  difficulty QuestionDifficulty?

  attachmentKey      String?
  attachmentFilename String?
  attachmentMimeType String?

  imageKey      String?
  imageFilename String?
  imageMimeType String?

  sourceQuestionId String?

  attempt  PracticeAttempt                 @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  options  PracticeAttemptQuestionOption[]
  response PracticeAttemptResponse?

  createdAt DateTime @default(now())

  @@index([attemptId])
}

model PracticeAttemptQuestionOption {
  id                String  @id @default(cuid())
  attemptQuestionId String
  text              String
  isCorrect         Boolean @default(false)
  order             Int

  imageKey      String?
  imageFilename String?
  imageMimeType String?

  attemptQuestion PracticeAttemptQuestion @relation(fields: [attemptQuestionId], references: [id], onDelete: Cascade)

  @@index([attemptQuestionId])
}

// BANK-mode equivalent of PracticeResponse — simpler because every bank
// question is auto-gradable by construction (ESSAY/FILE_UPLOAD are blocked
// at question-create time for BANK-mode quizzes), so there's no manual
// grading state (no fileKey/gradedByMembershipId/feedback) and no pending
// status — a bank attempt goes straight from SUBMITTED to GRADED.
model PracticeAttemptResponse {
  id                String   @id @default(cuid())
  attemptId         String
  attemptQuestionId String   @unique
  answer            Json?
  awardedPoints     Decimal? @db.Decimal(6, 2)

  attempt         PracticeAttempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptQuestion PracticeAttemptQuestion @relation(fields: [attemptQuestionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([attemptId])
}

model PracticeResponse {
  id                   String   @id @default(cuid())
  attemptId            String
  questionId           String
  answer               Json?
  fileKey              String?
  awardedPoints        Decimal? @db.Decimal(6, 2)
  autoGraded           Boolean  @default(false)
  gradedByMembershipId String?
  feedback             String?

  attempt  PracticeAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question PracticeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  gradedBy Membership?      @relation("PracticeResponseGradedBy", fields: [gradedByMembershipId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

// See AuditLog above — identical activity-log pattern, kept as a fully
// separate table so it never mixes with regular-quiz activity.
model PracticeAuditLog {
  id                String  @id @default(cuid())
  tenantId          String
  practiceQuizId    String?
  actorMembershipId String?
  action            String
  detail            String?

  practiceQuiz PracticeQuiz? @relation(fields: [practiceQuizId], references: [id], onDelete: Cascade)
  actor        Membership?   @relation(fields: [actorMembershipId], references: [id])

  createdAt DateTime @default(now())

  @@index([practiceQuizId])
  @@index([tenantId])
}

// In-app notification for one membership (never shared across memberships,
// even for the same user in another tenant) — the redirect target lives in
// `link` as an app-relative path the frontend navigates to on click. `type`
// is a small closed set of string tags (see NotificationType in
// notifications.service.ts), kept as a plain string for the same reason as
// AuditLog.action: new types are cheap to add and don't need a migration.
//
// Exactly one of membershipId / recipientUserId is set: membershipId for
// ordinary tenant-scoped notifications (a real Membership row), or
// recipientUserId for platform-level ones aimed at a User directly — the
// only case today is a super admin, who has no membership of their own to
// scope a tenant notification to.
model Notification {
  id              String  @id @default(cuid())
  tenantId        String?
  membershipId    String?
  recipientUserId String?
  type            String
  title           String
  body            String?
  link            String?
  read            Boolean @default(false)

  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  recipient  User?       @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([membershipId, read])
  @@index([recipientUserId, read])
  @@index([tenantId])
}

enum IdentityProvider {
  PASSWORD
  GOOGLE
}

enum SessionContext {
  ACCOUNT
  MEMBERSHIP
  SUPERADMIN
  PICKER
}

enum OtpPurpose {
  SIGNUP_VERIFY
  LOGIN_VERIFY
  PASSWORD_RESET
  STEP_UP
  TENANT_REQUEST
  EMAIL_CHANGE
}

enum PrincipalKind {
  USER
  REGISTRATION
  TENANT_REQUEST
  DECOY
}

enum ChallengeState {
  PENDING_SEND
  READY
  CONSUMED
  EXPIRED
  LOCKED
  CANCELLED
  FAILED
}

enum MailSubmission {
  PENDING
  CONFIRMED
  FAILED
  UNKNOWN
}

enum DeliveryProvenance {
  BREVO
  CONSOLE
  TEST
  OPERATOR
}

enum GoogleIntent {
  LOGIN
  LINK
}

enum GrantAction {
  PASSWORD_RESET
  PASSWORD_CHANGE
  PASSWORD_SET
  EMAIL_CHANGE_START
  GOOGLE_LINK
  GOOGLE_UNLINK
  ADMIN_EMAIL_CHANGE
  ADMIN_PASSWORD_SET
  ADMIN_SUPPRESSION_CLEAR
}

enum MailCategory {
  OTP
  INVITE
  SECURITY
}

enum MailAttemptOutcome {
  RESERVED
  ACCEPTED
  REJECTED
  UNKNOWN
}

enum OutboxStatus {
  PENDING
  SENDING
  SENT
  FAILED
  UNKNOWN
  CANCELLED
}

enum RecipientState {
  OK
  SUPPRESSED
}

model AuthIdentity {
  id             String           @id @default(cuid())
  userId         String
  provider       IdentityProvider
  providerUserId String
  email          String?
  emailVerified  Boolean          @default(false)
  lastUsedAt     DateTime?        @db.Timestamptz(3)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
}

model Session {
  id                 String               @id @default(uuid()) @db.Uuid
  userId             String
  membershipId       String?
  context            SessionContext
  contextVersion     Int                  @default(0)
  refreshGeneration  Int                  @default(0)
  tokenVersion       Int
  authMethods        String[]
  firstFactorAt      DateTime             @db.Timestamptz(3)
  otpVerifiedAt      DateTime?            @db.Timestamptz(3)
  currentRefreshHash String?              @unique
  currentRefreshJti  String?              @unique
  lastUsedAt         DateTime             @db.Timestamptz(3)
  idleExpiresAt      DateTime             @db.Timestamptz(3)
  absoluteExpiresAt  DateTime             @db.Timestamptz(3)
  revokedAt          DateTime?            @db.Timestamptz(3)
  revokedReason      String?
  userAgent          String?              @db.VarChar(512)
  ip                 String?              @db.VarChar(45)
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership         Membership?          @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  refreshUses        RefreshTokenUse[]
  selections         WorkspaceSelection[]
  challenges         AuthChallenge[]
  grants             AuthGrant[]
  nonces             GoogleNonce[]
  pendingLinks       PendingGoogleLink[]
  pendingEmails      PendingEmailChange[]
  securityEvents     SecurityEvent[]
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(3)

  @@index([userId, revokedAt])
  @@index([membershipId])
  @@index([idleExpiresAt])
  @@index([absoluteExpiresAt])
}

model RefreshTokenUse {
  id           String    @id @default(cuid())
  sessionId    String    @db.Uuid
  jti          String    @unique
  tokenHash    String    @unique
  issuedAt     DateTime  @db.Timestamptz(3)
  jwtExpiresAt DateTime  @db.Timestamptz(3)
  consumedAt   DateTime? @db.Timestamptz(3)
  graceUntil   DateTime? @db.Timestamptz(3)
  session      Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  @@index([sessionId, consumedAt])
  @@index([jwtExpiresAt])
}

model TrustedDevice {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String    @unique
  label             String?   @db.VarChar(100)
  lastIp            String?   @db.VarChar(45)
  lastUsedAt        DateTime  @db.Timestamptz(3)
  expiresAt         DateTime  @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId, expiresAt])
}

model WorkspaceSelection {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  sessionId    String    @db.Uuid
  contextHash  String
  tokenVersion Int
  expiresAt    DateTime  @db.Timestamptz(3)
  consumedAt   DateTime? @db.Timestamptz(3)
  session      Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  @@index([expiresAt])
}

model AuthChallenge {
  id                    String               @id @default(cuid())
  publicId              String               @unique
  purpose               OtpPurpose
  principalKind         PrincipalKind
  userId                String?
  pendingRegistrationId String?
  tenantRequestId       String?
  contextHash           String
  emailNormalized       String
  userTokenVersion      Int?
  firstFactor           IdentityProvider?
  firstFactorAt         DateTime?            @db.Timestamptz(3)
  loginReasons          String[]             @default([])
  sessionId             String?              @db.Uuid
  action                GrantAction?
  actionTargetHash      String?
  googleSub             String?
  googleEmail           String?
  googleAuthoritative   Boolean?
  pendingGoogleLinkId   String?
  invitationId          String?
  invitationTokenHash   String?
  pendingEmailChangeId  String?              @unique
  state                 ChallengeState       @default(PENDING_SEND)
  expiresAt             DateTime             @db.Timestamptz(3)
  attempts              Int                  @default(0)
  currentGeneration     Int                  @default(0)
  consumedAt            DateTime?            @db.Timestamptz(3)
  failureReason         String?
  user                  User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  registration          PendingRegistration? @relation(fields: [pendingRegistrationId], references: [id], onDelete: Cascade)
  tenantRequest         TenantRequest?       @relation(fields: [tenantRequestId], references: [id], onDelete: Cascade)
  session               Session?             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  pendingGoogleLink     PendingGoogleLink?   @relation(fields: [pendingGoogleLinkId], references: [id], onDelete: Cascade)
  invitation            MemberInvitation?    @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  pendingEmailChange    PendingEmailChange?  @relation(fields: [pendingEmailChangeId], references: [id], onDelete: Cascade)
  otps                  EmailOtp[]
  grant                 AuthGrant?
  createdAt             DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @db.Timestamptz(3)

  @@index([userId, purpose])
  @@index([pendingRegistrationId])
  @@index([tenantRequestId])
  @@index([sessionId])
  @@index([expiresAt])
}

model EmailOtp {
  id                 String             @id @default(cuid())
  challengeId        String
  generation         Int
  codeHash           String
  pepperVersion      Int
  sentTo             String
  submission         MailSubmission     @default(PENDING)
  deliveryProvenance DeliveryProvenance
  providerMessageId  String?
  dispatchId         String             @unique
  expiresAt          DateTime           @db.Timestamptz(3)
  confirmedAt        DateTime?          @db.Timestamptz(3)
  consumedAt         DateTime?          @db.Timestamptz(3)
  challenge          AuthChallenge      @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)

  @@unique([challengeId, generation])
  @@index([expiresAt])
}

model PendingRegistration {
  id                  String            @id @default(cuid())
  email               String
  emailNormalized     String
  name                String
  provider            IdentityProvider
  passwordHash        String?
  googleSub           String?
  googleEmail         String?
  googleAuthoritative Boolean?
  contextHash         String
  invitationId        String?
  expiresAt           DateTime          @db.Timestamptz(3)
  completedAt         DateTime?         @db.Timestamptz(3)
  invitation          MemberInvitation? @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  challenges          AuthChallenge[]
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(3)

  @@index([emailNormalized])
  @@index([expiresAt])
}

model GoogleNonce {
  id          String       @id @default(cuid())
  nonceHash   String       @unique
  contextHash String
  intent      GoogleIntent
  userId      String?
  sessionId   String?      @db.Uuid
  expiresAt   DateTime     @db.Timestamptz(3)
  consumedAt  DateTime?    @db.Timestamptz(3)
  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  session     Session?     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  @@index([expiresAt])
}

model PendingGoogleLink {
  id            String          @id @default(cuid())
  userId        String
  sessionId     String          @db.Uuid
  contextHash   String
  googleSub     String
  providerEmail String
  authoritative Boolean
  tokenVersion  Int
  expiresAt     DateTime        @db.Timestamptz(3)
  consumedAt    DateTime?       @db.Timestamptz(3)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  session       Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  challenges    AuthChallenge[]
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)

  @@index([userId, sessionId])
  @@index([expiresAt])
}

model AuthGrant {
  id                String        @id @default(cuid())
  tokenHash         String        @unique
  sourceChallengeId String        @unique
  userId            String
  sessionId         String?       @db.Uuid
  contextHash       String
  action            GrantAction
  actionTargetHash  String?
  tokenVersion      Int
  expiresAt         DateTime      @db.Timestamptz(3)
  consumedAt        DateTime?     @db.Timestamptz(3)
  sourceChallenge   AuthChallenge @relation(fields: [sourceChallengeId], references: [id], onDelete: Cascade)
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  session           Session?      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  @@index([expiresAt])
  @@index([userId])
}

model PendingEmailChange {
  id                 String         @id @default(cuid())
  userId             String
  sessionId          String         @db.Uuid
  oldEmailNormalized String
  newEmail           String
  newEmailNormalized String
  tokenVersion       Int
  expiresAt          DateTime       @db.Timestamptz(3)
  completedAt        DateTime?      @db.Timestamptz(3)
  invalidatedAt      DateTime?      @db.Timestamptz(3)
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  session            Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  challenge          AuthChallenge?
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(3)

  @@index([expiresAt])
}

model LoginFailure {
  identifierHash String
  sourceHash     String
  count          Int
  lastFailedAt   DateTime @db.Timestamptz(3)
  nextAllowedAt  DateTime @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@id([identifierHash, sourceHash])
  @@index([lastFailedAt])
}

model AccountLoginRisk {
  userId       String   @id
  count        Int
  lastFailedAt DateTime @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
}

model AuthRateBucket {
  scope       String
  keyHash     String
  windowStart DateTime @db.Timestamptz(3)
  count       Int
  expiresAt   DateTime @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@id([scope, keyHash, windowStart])
  @@index([expiresAt])
}

model OtpSendReservation {
  id            String   @id @default(cuid())
  recipientHash String
  sourceHash    String
  challengeId   String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  @@index([recipientHash, createdAt])
  @@index([sourceHash, createdAt])
}

model MailSendBudget {
  day             DateTime  @id @db.Date
  totalAttempts   Int       @default(0)
  otpAttempts     Int       @default(0)
  nonOtpAttempts  Int       @default(0)
  budgetAlertedAt DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
}

model MailAttempt {
  id                String             @id @default(cuid())
  dispatchId        String
  attemptNumber     Int
  category          MailCategory
  reservedAt        DateTime           @db.Timestamptz(3)
  outcome           MailAttemptOutcome @default(RESERVED)
  providerCode      String?
  providerMessageId String?
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)

  @@unique([dispatchId, attemptNumber])
  @@index([reservedAt, category])
}

model MailOutbox {
  id                        String       @id @default(cuid())
  category                  MailCategory
  recipient                 String
  templateType              String
  templateVersion           Int          @default(1)
  payload                   Json
  senderSnapshot            Json
  appOriginSnapshot         String
  renderedPayloadCiphertext String?
  payloadKeyVersion         Int?
  payloadNonce              String?
  renderedContentHash       String?
  dispatchId                String       @unique
  idempotencyKey            String       @unique
  status                    OutboxStatus @default(PENDING)
  attemptCount              Int          @default(0)
  nextAttemptAt             DateTime     @db.Timestamptz(3)
  firstAttemptAt            DateTime?    @db.Timestamptz(3)
  leaseOwner                String?
  leaseExpiresAt            DateTime?    @db.Timestamptz(3)
  lastErrorKind             String?
  expiresAt                 DateTime     @db.Timestamptz(3)
  createdAt                 DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime     @updatedAt @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@index([leaseExpiresAt])
}

model MailRecipient {
  emailCanonical   String         @id
  state            RecipientState @default(OK)
  reason           String?
  suppressedAt     DateTime?      @db.Timestamptz(3)
  softFailureCount Int            @default(0)
  lastEventAt      DateTime?      @db.Timestamptz(3)
  lastClearedAt    DateTime?      @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)
}

model MailDelivery {
  id              String         @id @default(cuid())
  dispatchId      String         @unique
  provider        String
  messageId       String?
  recipient       String
  category        MailCategory
  submissionState MailSubmission
  deliveryState   String         @default("pending")
  lastEventAt     DateTime?      @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  @@unique([provider, messageId, recipient])
  @@index([createdAt])
}

model MailDeliveryEvent {
  id              String    @id @default(cuid())
  provider        String
  messageId       String
  recipient       String
  event           String
  providerEventAt DateTime  @db.Timestamptz(3)
  payloadHash     String
  receivedAt      DateTime  @db.Timestamptz(3)
  reason          String?
  dispatchId      String?
  reconciledAt    DateTime? @db.Timestamptz(3)
  // Bounded retry scheduling: an event whose delivery mapping has not arrived yet is
  // deferred rather than re-read on every sweep, so it cannot starve later events.
  attempts        Int       @default(0)
  nextAttemptAt   DateTime? @db.Timestamptz(3)
  // Terminal state for callbacks that will never acquire a mapping. Quarantining stops the
  // sweep revisiting the row; it changes no recipient state, so an unknown message can
  // never suppress an unrelated address.
  quarantinedAt   DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([provider, messageId, recipient, event, providerEventAt, payloadHash], map: "mail_event_dedup")
  @@index([messageId, recipient])
  @@index([receivedAt])
  @@index([nextAttemptAt], map: "MailDeliveryEvent_reconcile_queue_idx")
}

model SecurityEvent {
  id           String   @id @default(cuid())
  userId       String?
  sessionId    String?  @db.Uuid
  actorKey     String?
  type         String
  outcome      String
  sourceIpHash String?
  metadata     Json
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  session      Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
}

model OperationalAlert {
  id             String    @id @default(cuid())
  type           String
  dedupeKey      String    @unique
  acknowledgedAt DateTime? @db.Timestamptz(3)
  metadata       Json
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  @@index([createdAt])
}

model AuthJobLease {
  name      String   @id
  owner     String
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model CspReport {
  id          String   @id @default(cuid())
  directive   String
  blockedUrl  String?
  documentUrl String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([createdAt])
}
