generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STUDENT
}

enum TenantRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum QuestionType {
  MCQ_SINGLE
  MCQ_MULTI
  TRUE_FALSE
  SHORT_TEXT
  NUMERIC
  ESSAY
  MATCHING
  FILL_BLANK
  FILE_UPLOAD
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

// Declared in play order — Postgres native enums sort by declaration
// ordinal, so `orderBy: [{ module: 'asc' }, { order: 'asc' }]` queries rely
// on this order to come back in actual SAT sequence.
enum QuizModule {
  RW_MODULE_1
  RW_MODULE_2
  MATH_MODULE_1
  MATH_MODULE_2
}

enum QuizStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

// FIXED: the admin authors an exact question set every student sees.
// BANK: the admin uploads a large tagged-difficulty pool and each attempt
// draws its own random SAT-sized subset (see PracticeAttemptQuestion).
enum PracticeQuizMode {
  FIXED
  BANK
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

model User {
  id                     String                 @id @default(cuid())
  email                  String                 @unique
  passwordHash           String
  // Bumped whenever the password changes; embedded in every issued token and
  // checked on refresh — invalidates every other session's refresh token
  // (all other devices/tabs) the moment the password is changed, without a
  // token-revocation table. The session that made the change is re-issued
  // fresh tokens at the same call so only it survives.
  tokenVersion           Int                    @default(0)
  // Hashes of the last PASSWORD_HISTORY_LIMIT passwords (most recent first),
  // checked on change so a "new" password can't just be an old one again.
  previousPasswordHashes String[]               @default([])
  name                   String
  isSuperAdmin           Boolean                @default(false)
  isSuspended            Boolean                @default(false)
  suspendedAt            DateTime?
  lastLoginAt            DateTime?
  memberships            Membership[]
  workspaceJoinRequests  WorkspaceJoinRequest[]
  notifications          Notification[]
  passwordResetTokens    PasswordResetToken[]

  // Profile — most of these are only meaningful for STUDENT memberships
  // (gradeLevel, studentId, guardian*), but they live on User rather than a
  // role-scoped table since role is per-membership, not per-account.
  avatarUrl          String?
  firstName          String?
  lastName           String?
  dateOfBirth        DateTime? @db.Date
  bio                String?
  phone              String?
  location           String?
  timezone           String?
  locale             String?
  emailNotifications Boolean   @default(true)
  gradeLevel         String?
  studentId          String?
  guardianName       String?
  guardianContact    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tenant {
  id                    String                   @id @default(cuid())
  name                  String
  slug                  String                   @unique
  description           String?
  bannerImageUrl        String?
  joinCode              String?                  @unique
  status                TenantStatus             @default(ACTIVE)
  suspendedAt           DateTime?
  memberships           Membership[]
  groups                Group[]
  quizzes               Quiz[]
  assignments           QuizAssignment[]
  practiceQuizzes       PracticeQuiz[]
  practiceAssignments   PracticeQuizAssignment[]
  tenantRequests        TenantRequest[]
  workspaceJoinRequests WorkspaceJoinRequest[]
  memberInvitations     MemberInvitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A user can hold at most one membership per tenant (@@unique([userId,
// tenantId])), but may belong to multiple tenants at once — e.g. a student
// added by two different schools/workspaces.
model Membership {
  id       String @id @default(cuid())
  userId   String
  tenantId String
  role     Role

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdQuizzes      Quiz[]             @relation("QuizCreatedBy")
  groupMemberships    GroupMember[]
  assignmentsCreated  QuizAssignment[]   @relation("AssignmentCreatedBy")
  assignmentsReceived QuizAssignment[]   @relation("AssignmentStudent")
  attempts            Attempt[]
  gradedResponses     Response[]         @relation("ResponseGradedBy")
  auditLogs           AuditLog[]
  sentInvitations     MemberInvitation[]
  notifications       Notification[]

  createdPracticeQuizzes      PracticeQuiz[]           @relation("PracticeQuizCreatedBy")
  practiceAssignmentsCreated  PracticeQuizAssignment[] @relation("PracticeAssignmentCreatedBy")
  practiceAssignmentsReceived PracticeQuizAssignment[] @relation("PracticeAssignmentStudent")
  practiceAttempts            PracticeAttempt[]
  gradedPracticeResponses     PracticeResponse[]       @relation("PracticeResponseGradedBy")
  practiceAuditLogs           PracticeAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tenantId])
  @@index([tenantId])
}

// A public request for a new workspace, reviewed by a platform super admin
// (User.isSuperAdmin). Approval creates the Tenant + User + Membership.
model TenantRequest {
  id             String              @id @default(cuid())
  workspaceName  String
  slug           String              @unique
  description    String?
  requesterName  String
  requesterEmail String
  passwordHash   String
  status         TenantRequestStatus @default(PENDING)
  tenantId       String?
  tenant         Tenant?             @relation(fields: [tenantId], references: [id])

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
}

// A registered user asking to join an existing tenant as a STUDENT,
// reviewed by that tenant's own ADMIN(s). Distinct from TenantRequest,
// which is a request to create a brand-new tenant, reviewed by the
// platform super admin.
model WorkspaceJoinRequest {
  id       String              @id @default(cuid())
  userId   String
  tenantId String
  status   TenantRequestStatus @default(PENDING)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  @@index([tenantId])
  @@index([userId])
}

enum MemberInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

// An admin-initiated invite for an email with no existing account yet.
// Distinct from WorkspaceJoinRequest, which is student-initiated — an
// invitation is created by the tenant's own admin and pre-assigns a role;
// the invitee accepts it by setting a password at /accept-invite/:token.
// A single-use, expiring token for the "forgot password" flow. The token
// itself is only ever emailed to the user — tokenHash (sha256) is what's
// stored, so a DB leak alone can't be used to take over accounts.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MemberInvitation {
  id                    String                 @id @default(cuid())
  tenantId              String
  email                 String
  role                  Role
  token                 String                 @unique
  status                MemberInvitationStatus @default(PENDING)
  invitedByMembershipId String?

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy Membership? @relation(fields: [invitedByMembershipId], references: [id])

  createdAt  DateTime  @default(now())
  acceptedAt DateTime?

  @@index([tenantId])
}

model Group {
  id       String @id @default(cuid())
  tenantId String
  name     String

  tenant              Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members             GroupMember[]
  assignments         QuizAssignment[]
  practiceAssignments PracticeQuizAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model GroupMember {
  id           String @id @default(cuid())
  groupId      String
  membershipId String

  group      Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([groupId, membershipId])
}

model Quiz {
  id                       String     @id @default(cuid())
  tenantId                 String
  createdByMembershipId    String
  title                    String
  description              String?
  maxAttempts              Int?
  shuffleQuestions         Boolean    @default(false)
  shuffleOptions           Boolean    @default(false)
  showDifficultyToStudents Boolean    @default(false)
  availableFrom            DateTime?
  availableUntil           DateTime?
  passMarkPercent          Decimal?   @db.Decimal(5, 2)
  status                   QuizStatus @default(DRAFT)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy   Membership       @relation("QuizCreatedBy", fields: [createdByMembershipId], references: [id])
  questions   Question[]
  assignments QuizAssignment[]
  attempts    Attempt[]
  auditLogs   AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// `config` holds type-specific settings (numeric tolerance, matching
// pairs, blank definitions...) per packages/shared question-config schemas.
// MCQ_SINGLE / MCQ_MULTI / TRUE_FALSE use QuestionOption instead.
model Question {
  id         String              @id @default(cuid())
  quizId     String
  module     QuizModule
  type       QuestionType
  prompt     String
  points     Decimal             @db.Decimal(6, 2)
  // Position within this question's module, not the whole quiz — order is
  // scoped to (quizId, module) by the create/reorder/duplicate logic.
  order      Int
  config     Json                @default("{}")
  difficulty QuestionDifficulty?

  // Optional reference document (PDF/DOCX) a teacher attaches for students
  // to view alongside the question — separate from `config` so it survives
  // the per-type answer-key stripping in question-sanitizer.ts untouched.
  attachmentKey      String?
  attachmentFilename String?
  attachmentMimeType String?

  // Optional image shown inline with the question prompt — distinct from the
  // reference-document attachment above.
  imageKey      String?
  imageFilename String?
  imageMimeType String?

  quiz      Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options   QuestionOption[]
  responses Response[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quizId])
}

model QuestionOption {
  id         String  @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean @default(false)
  order      Int

  // Optional image shown inline with this answer option.
  imageKey      String?
  imageFilename String?
  imageMimeType String?

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

// Exactly one of studentMembershipId / groupId is set.
model QuizAssignment {
  id                     String    @id @default(cuid())
  tenantId               String
  quizId                 String
  studentMembershipId    String?
  groupId                String?
  assignedByMembershipId String
  dueAt                  DateTime?

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quiz       Quiz        @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student    Membership? @relation("AssignmentStudent", fields: [studentMembershipId], references: [id], onDelete: Cascade)
  group      Group?      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  assignedBy Membership  @relation("AssignmentCreatedBy", fields: [assignedByMembershipId], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([quizId])
}

model Attempt {
  id                  String        @id @default(cuid())
  quizId              String
  studentMembershipId String
  attemptNumber       Int
  status              AttemptStatus @default(IN_PROGRESS)
  startedAt           DateTime      @default(now())
  submittedAt         DateTime?
  score               Decimal?      @db.Decimal(7, 2)
  maxScore            Decimal?      @db.Decimal(7, 2)

  // Single-active-session lock, held by whichever login session is currently
  // taking this attempt. `lockSessionId` matches the `sessionId` claim on
  // that session's JWTs; a new login for this attempt's student is refused
  // (see AuthService.issueTokensForMembership) while lastHeartbeatAt is
  // still within the liveness window, so at most one device can act on an
  // in-progress attempt at a time. Cleared on submit, and force-clearable by
  // a teacher if a device goes stale without a clean handoff.
  lockSessionId   String?
  lockedAt        DateTime?
  lastHeartbeatAt DateTime?

  quiz      Quiz                    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student   Membership              @relation(fields: [studentMembershipId], references: [id], onDelete: Cascade)
  responses Response[]
  modules   AttemptModuleProgress[]

  @@unique([quizId, studentMembershipId, attemptNumber])
  @@index([quizId])
  @@index([studentMembershipId])
}

// Tracks per-module timing/completion within one Attempt. A row's absence
// of `submittedAt` marks it the currently-active module; the next module's
// row is only created once the previous one is explicitly completed (see
// AttemptsService.completeCurrentModule/beginNextModule), so there is at
// most one "open" row per attempt at a time. This is what makes the fixed
// 32/32/35/35-minute module timers server-enforced rather than merely
// displayed to the client.
model AttemptModuleProgress {
  id            String     @id @default(cuid())
  attemptId     String
  module        QuizModule
  startedAt     DateTime   @default(now())
  submittedAt   DateTime?
  autoSubmitted Boolean    @default(false)

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, module])
  @@index([attemptId])
}

model Response {
  id                   String   @id @default(cuid())
  attemptId            String
  questionId           String
  answer               Json?
  fileKey              String?
  awardedPoints        Decimal? @db.Decimal(6, 2)
  autoGraded           Boolean  @default(false)
  gradedByMembershipId String?
  feedback             String?

  attempt  Attempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  gradedBy Membership? @relation("ResponseGradedBy", fields: [gradedByMembershipId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

// A persisted, human-readable history of actions taken on a quiz — powers
// the quiz detail page's "Activity log". `action` is a small closed set of
// string tags ('QUIZ_CREATED' | 'STATUS_CHANGED' | 'SETTINGS_UPDATED' |
// 'QUESTIONS_UPDATED' | 'ASSIGNMENT_CREATED' | 'ASSIGNMENT_REMOVED'); kept
// as a plain string rather than an enum since new action types are cheap to
// add and don't need a migration. `detail` carries the one piece of
// context each message needs (new status, or an assignment target name).
model AuditLog {
  id                String  @id @default(cuid())
  tenantId          String
  quizId            String?
  actorMembershipId String?
  action            String
  detail            String?

  quiz  Quiz?       @relation(fields: [quizId], references: [id], onDelete: Cascade)
  actor Membership? @relation(fields: [actorMembershipId], references: [id])

  createdAt DateTime @default(now())

  @@index([quizId])
  @@index([tenantId])
}

// Practice Quiz is a fully independent copy of the Quiz feature (own tables,
// own services/controllers) so bug fixes or behavior changes on one never
// affect the other. Field-for-field mirror of Quiz/Question/QuestionOption/
// QuizAssignment/Attempt/AttemptModuleProgress/Response/AuditLog above.

model PracticeQuiz {
  id                       String     @id @default(cuid())
  tenantId                 String
  createdByMembershipId    String
  title                    String
  description              String?
  maxAttempts              Int?
  shuffleQuestions         Boolean    @default(false)
  shuffleOptions           Boolean    @default(false)
  showDifficultyToStudents Boolean    @default(false)
  availableFrom            DateTime?
  availableUntil           DateTime?
  passMarkPercent          Decimal?   @db.Decimal(5, 2)
  status                   QuizStatus @default(DRAFT)

  // Set at creation, immutable after — see PracticeQuizMode. bankModuleTargets
  // is Record<QuizModule, number>; bankDifficultyRatio is
  // {EASY,MEDIUM,HARD} percentages summing to 100. Both null for FIXED mode.
  mode                PracticeQuizMode @default(FIXED)
  bankModuleTargets   Json?
  bankDifficultyRatio Json?

  tenant      Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy   Membership               @relation("PracticeQuizCreatedBy", fields: [createdByMembershipId], references: [id])
  questions   PracticeQuestion[]
  assignments PracticeQuizAssignment[]
  attempts    PracticeAttempt[]
  auditLogs   PracticeAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model PracticeQuestion {
  id         String              @id @default(cuid())
  quizId     String
  module     QuizModule
  type       QuestionType
  prompt     String
  points     Decimal             @db.Decimal(6, 2)
  order      Int
  config     Json                @default("{}")
  difficulty QuestionDifficulty?

  attachmentKey      String?
  attachmentFilename String?
  attachmentMimeType String?

  imageKey      String?
  imageFilename String?
  imageMimeType String?

  quiz      PracticeQuiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options   PracticeQuestionOption[]
  responses PracticeResponse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quizId])
}

model PracticeQuestionOption {
  id         String  @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean @default(false)
  order      Int

  imageKey      String?
  imageFilename String?
  imageMimeType String?

  question PracticeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

// Exactly one of studentMembershipId / groupId is set.
model PracticeQuizAssignment {
  id                     String    @id @default(cuid())
  tenantId               String
  quizId                 String
  studentMembershipId    String?
  groupId                String?
  assignedByMembershipId String
  dueAt                  DateTime?

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quiz       PracticeQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student    Membership?  @relation("PracticeAssignmentStudent", fields: [studentMembershipId], references: [id], onDelete: Cascade)
  group      Group?       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  assignedBy Membership   @relation("PracticeAssignmentCreatedBy", fields: [assignedByMembershipId], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([quizId])
}

model PracticeAttempt {
  id                  String        @id @default(cuid())
  quizId              String
  studentMembershipId String
  attemptNumber       Int
  status              AttemptStatus @default(IN_PROGRESS)
  startedAt           DateTime      @default(now())
  submittedAt         DateTime?
  score               Decimal?      @db.Decimal(7, 2)
  maxScore            Decimal?      @db.Decimal(7, 2)

  // Single-active-session lock — see Attempt.lockSessionId above for the
  // full mechanics; identical here.
  lockSessionId   String?
  lockedAt        DateTime?
  lastHeartbeatAt DateTime?

  quiz      PracticeQuiz                    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student   Membership                      @relation(fields: [studentMembershipId], references: [id], onDelete: Cascade)
  responses PracticeResponse[]
  modules   PracticeAttemptModuleProgress[]

  // BANK-mode only — see PracticeAttemptQuestion.
  attemptQuestions PracticeAttemptQuestion[]
  attemptResponses PracticeAttemptResponse[]

  @@unique([quizId, studentMembershipId, attemptNumber])
  @@index([quizId])
  @@index([studentMembershipId])
}

// See AttemptModuleProgress above — identical per-module timing/completion
// tracking, mirrored for PracticeAttempt.
model PracticeAttemptModuleProgress {
  id            String     @id @default(cuid())
  attemptId     String
  module        QuizModule
  startedAt     DateTime   @default(now())
  submittedAt   DateTime?
  autoSubmitted Boolean    @default(false)

  attempt PracticeAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, module])
  @@index([attemptId])
}

// One row per question actually drawn into a BANK-mode attempt — a frozen
// content copy, field-for-field mirroring PracticeQuestion, so review stays
// correct forever even after the admin edits or deletes the source bank
// question. `sourceQuestionId` is provenance only (no FK, no cascade) —
// deleting the live bank question must never touch an attempt's snapshot.
model PracticeAttemptQuestion {
  id         String              @id @default(cuid())
  attemptId  String
  module     QuizModule
  type       QuestionType
  prompt     String
  points     Decimal             @db.Decimal(6, 2)
  order      Int
  config     Json                @default("{}")
  difficulty QuestionDifficulty?

  attachmentKey      String?
  attachmentFilename String?
  attachmentMimeType String?

  imageKey      String?
  imageFilename String?
  imageMimeType String?

  sourceQuestionId String?

  attempt  PracticeAttempt                 @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  options  PracticeAttemptQuestionOption[]
  response PracticeAttemptResponse?

  createdAt DateTime @default(now())

  @@index([attemptId])
}

model PracticeAttemptQuestionOption {
  id                String  @id @default(cuid())
  attemptQuestionId String
  text              String
  isCorrect         Boolean @default(false)
  order             Int

  imageKey      String?
  imageFilename String?
  imageMimeType String?

  attemptQuestion PracticeAttemptQuestion @relation(fields: [attemptQuestionId], references: [id], onDelete: Cascade)

  @@index([attemptQuestionId])
}

// BANK-mode equivalent of PracticeResponse — simpler because every bank
// question is auto-gradable by construction (ESSAY/FILE_UPLOAD are blocked
// at question-create time for BANK-mode quizzes), so there's no manual
// grading state (no fileKey/gradedByMembershipId/feedback) and no pending
// status — a bank attempt goes straight from SUBMITTED to GRADED.
model PracticeAttemptResponse {
  id                String   @id @default(cuid())
  attemptId         String
  attemptQuestionId String   @unique
  answer            Json?
  awardedPoints     Decimal? @db.Decimal(6, 2)

  attempt         PracticeAttempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptQuestion PracticeAttemptQuestion @relation(fields: [attemptQuestionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([attemptId])
}

model PracticeResponse {
  id                   String   @id @default(cuid())
  attemptId            String
  questionId           String
  answer               Json?
  fileKey              String?
  awardedPoints        Decimal? @db.Decimal(6, 2)
  autoGraded           Boolean  @default(false)
  gradedByMembershipId String?
  feedback             String?

  attempt  PracticeAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question PracticeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  gradedBy Membership?      @relation("PracticeResponseGradedBy", fields: [gradedByMembershipId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

// See AuditLog above — identical activity-log pattern, kept as a fully
// separate table so it never mixes with regular-quiz activity.
model PracticeAuditLog {
  id                String  @id @default(cuid())
  tenantId          String
  practiceQuizId    String?
  actorMembershipId String?
  action            String
  detail            String?

  practiceQuiz PracticeQuiz? @relation(fields: [practiceQuizId], references: [id], onDelete: Cascade)
  actor        Membership?   @relation(fields: [actorMembershipId], references: [id])

  createdAt DateTime @default(now())

  @@index([practiceQuizId])
  @@index([tenantId])
}

// In-app notification for one membership (never shared across memberships,
// even for the same user in another tenant) — the redirect target lives in
// `link` as an app-relative path the frontend navigates to on click. `type`
// is a small closed set of string tags (see NotificationType in
// notifications.service.ts), kept as a plain string for the same reason as
// AuditLog.action: new types are cheap to add and don't need a migration.
//
// Exactly one of membershipId / recipientUserId is set: membershipId for
// ordinary tenant-scoped notifications (a real Membership row), or
// recipientUserId for platform-level ones aimed at a User directly — the
// only case today is a super admin, who has no membership of their own to
// scope a tenant notification to.
model Notification {
  id              String  @id @default(cuid())
  tenantId        String?
  membershipId    String?
  recipientUserId String?
  type            String
  title           String
  body            String?
  link            String?
  read            Boolean @default(false)

  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  recipient  User?       @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([membershipId, read])
  @@index([recipientUserId, read])
  @@index([tenantId])
}
